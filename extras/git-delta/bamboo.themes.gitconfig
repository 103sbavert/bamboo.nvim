[delta "bamboo"]
    dark = true
    syntax-theme = bamboo 
    file-added-label = [+]
    file-copied-label = [==]
    file-modified-label = [*]
    file-removed-label = [-]
    file-renamed-label = [->]
    file-style = "#ff9966" bold
    file-decoration-style = "#57a5e5" ul
    hunk-header-decoration-style = "#57a5e5" box ul
    hunk-header-file-style = "#96c7ef"
    hunk-header-line-number-style = "#dbb651" bold
    hunk-header-style = file line-number syntax
    line-numbers = true
    line-numbers-left-format = "{nm:>1}│"
    line-numbers-left-style = "#5b5e5a"
    line-numbers-minus-style = "#e75a7c" bold
    line-numbers-plus-style = "#8fb573" bold
    line-numbers-right-format = "{np:>1}│"
    line-numbers-right-style = "#5b5e5a"
    line-numbers-zero-style = "#838781" italic
    minus-style = syntax "#451f23"
    minus-emph-style = syntax bold "#893f45"
    plus-style = syntax "#202a0e"
    plus-emph-style = syntax bold "#40531b"
    zero-style = syntax
    whitespace-error-style = "#e75a7c" reverse
    commit-decoration-style = "#57a5e5" box
    commit-style = "#ff9966" bold
    blame-format = "{author:<18} ({commit:>7}) {timestamp:^16}"
    blame-palette = "#1c1e1b" "#252623" "#2f312c" "#383b35"
