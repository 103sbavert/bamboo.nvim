{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["green", "accent", "purple", "yellow"],
    "text": {
      "base": "#ece1c0",
      "muted": "#818781",
      "action": {
        "primary": { "base": "#ece1c0", "$hovered": "#88c1e9", "$selected": "#171f17", "$focused": "#171f17", "$disabled": "#5a5e5a" },
        "secondary": { "base": "#81af58", "$disabled": "#5a5e5a" },
        "destructive": { "base": "#171f17", "$hovered": "#171f17", "$focused": "#171f17", "$selected": "#171f17", "$disabled": "#5a5e5a" }
      },
      "formfield": { "base": "#ece1c0", "$disabled": "#5a5e5a" },
      "feedback": {
        "error": { "base": "#dc4f62" },
        "warning": { "base": "#ceba49" },
        "success": { "base": "#81af58" },
        "info": { "base": "#68baae" }
      }
    },
    "background": {
      "base": "#232923",
      "raised": { "base": "#2d312c", "high": "#363b35", "max": "#383d37" },
      "action": {
        "primary": { "base": "transparent", "$hovered": "#2d312c", "$focused": "#789959", "$selected": "#818781", "$disabled": "#5a5e5a" },
        "secondary": { "base": "#363b35", "$disabled": "#2d312c" },
        "destructive": { "base": "#dc4f62", "$disabled": "#5a5e5a" }
      },
      "formfield": { "base": "#2d312c", "$disabled": "#363b35" },
      "feedback": {
        "error": { "base": "#893f45" },
        "warning": { "base": "#2d312c" },
        "success": { "base": "#40531b" },
        "info": { "base": "#2a3a57" }
      }
    },
    "border": { "base": "#383d37" },
    "scrollbar": { "base": "#5a5e5a" },
    "diff": {
      "text": {
        "added": "#81af58",
        "removed": "#dc4f62",
        "context": "#818781",
        "hunkHeader": "#88c1e9"
      },
      "background": {
        "added": "#40531b",
        "removed": "#893f45",
        "context": "#2d312c"
      },
      "highlight": { "added": "#81af58", "removed": "#dc4f62" },
      "lineNumber": {
        "text": "#5a5e5a",
        "background": { "added": "#40531b", "removed": "#893f45" }
      }
    },
    "syntax": {
      "comment": "#5a5e5a",
      "keyword": "#dc4f62",
      "function": "#409cdc",
      "variable": "#ece1c0",
      "string": "#81af58",
      "number": "#ef9946",
      "type": "#ceba49",
      "operator": "#68baae",
      "punctuation": "#818781"
    },
    "markdown": {
      "text": "#ece1c0",
      "heading": "#81af58",
      "link": "#409cdc",
      "linkText": "#68baae",
      "code": "#e07870",
      "blockQuote": "#818781",
      "emphasis": "#ceba49",
      "strong": "#dc4f62",
      "horizontalRule": "#5a5e5a",
      "listItem": "#409cdc",
      "listEnumeration": "#68baae",
      "image": "#a09af8",
      "imageText": "#a09af8",
      "codeBlock": "#ece1c0"
    },
    "@dialog": {
      "background": { "base": "#2d312c" }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#5a5e5a",
