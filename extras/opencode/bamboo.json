        "300": "#dbb651",
        "400": "#dbb651",
        "500": "#dbb651",
        "600": "#dbb651",
        "700": "#dbb651",
        "800": "#dbb651",
        "900": "#dbb651"
      },
      "green": {
        "100": "#8fb573",
        "200": "#8fb573",
        "300": "#8fb573",
        "400": "#8fb573",
        "500": "#8fb573",
        "600": "#8fb573",
        "700": "#8fb573",
        "800": "#8fb573",
        "900": "#8fb573"
      },
      "cyan": {
        "100": "#70c2be",
        "200": "#70c2be",
        "300": "#70c2be",
        "400": "#70c2be",
        "500": "#70c2be",
        "600": "#70c2be",
        "700": "#70c2be",
        "800": "#70c2be",
        "900": "#70c2be"
      },
      "blue": {
