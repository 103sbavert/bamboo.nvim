{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["green", "accent", "purple", "yellow"],
    "text": {
      "base": "#f1e9d2",
      "muted": "#838781",
      "action": {
        "primary": { "base": "#f1e9d2", "$hovered": "#96c7ef", "$selected": "#1c1e1b", "$focused": "#1c1e1b", "$disabled": "#5b5e5a" },
        "secondary": { "base": "#8fb573", "$disabled": "#5b5e5a" },
        "destructive": { "base": "#1c1e1b", "$hovered": "#1c1e1b", "$focused": "#1c1e1b", "$selected": "#1c1e1b", "$disabled": "#5b5e5a" }
      },
      "formfield": { "base": "#f1e9d2", "$disabled": "#5b5e5a" },
      "feedback": {
        "error": { "base": "#e75a7c" },
        "warning": { "base": "#dbb651" },
        "success": { "base": "#8fb573" },
        "info": { "base": "#70c2be" }
      }
    },
    "background": {
      "base": "#252623",
      "raised": { "base": "#2f312c", "high": "#383b35", "max": "#3a3d37" },
      "action": {
        "primary": { "base": "transparent", "$hovered": "#2f312c", "$focused": "#84a070", "$selected": "#838781", "$disabled": "#5b5e5a" },
        "secondary": { "base": "#383b35", "$disabled": "#2f312c" },
        "destructive": { "base": "#e75a7c", "$disabled": "#5b5e5a" }
      },
      "formfield": { "base": "#2f312c", "$disabled": "#383b35" },
      "feedback": {
        "error": { "base": "#893f45" },
        "warning": { "base": "#2f312c" },
        "success": { "base": "#40531b" },
        "info": { "base": "#2a3a57" }
      }
    },
    "border": { "base": "#3a3d37" },
    "scrollbar": { "base": "#5b5e5a" },
    "diff": {
      "text": {
        "added": "#8fb573",
        "removed": "#e75a7c",
        "context": "#838781",
        "hunkHeader": "#96c7ef"
      },
      "background": {
        "added": "#40531b",
        "removed": "#893f45",
        "context": "#2f312c"
      },
      "highlight": { "added": "#8fb573", "removed": "#e75a7c" },
      "lineNumber": {
        "text": "#5b5e5a",
        "background": { "added": "#40531b", "removed": "#893f45" }
      }
    },
    "syntax": {
      "comment": "#5b5e5a",
      "keyword": "#e75a7c",
      "function": "#57a5e5",
      "variable": "#f1e9d2",
      "string": "#8fb573",
      "number": "#ff9966",
      "type": "#dbb651",
      "operator": "#70c2be",
      "punctuation": "#838781"
    },
    "markdown": {
      "text": "#f1e9d2",
      "heading": "#8fb573",
      "link": "#57a5e5",
      "linkText": "#70c2be",
      "code": "#f08080",
      "blockQuote": "#838781",
      "emphasis": "#dbb651",
      "strong": "#e75a7c",
      "horizontalRule": "#5b5e5a",
      "listItem": "#57a5e5",
      "listEnumeration": "#70c2be",
      "image": "#aaaaff",
      "imageText": "#aaaaff",
      "codeBlock": "#f1e9d2"
    },
    "@dialog": {
      "background": { "base": "#2f312c" }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#5b5e5a",
        "200": "#5b5e5a",
        "300": "#5b5e5a",
        "400": "#5b5e5a",
        "500": "#5b5e5a",
        "600": "#5b5e5a",
        "700": "#5b5e5a",
        "800": "#5b5e5a",
        "900": "#5b5e5a"
      },
      "red": {
        "100": "#e75a7c",
        "200": "#e75a7c",
        "300": "#e75a7c",
        "400": "#e75a7c",
        "500": "#e75a7c",
        "600": "#e75a7c",
        "700": "#e75a7c",
        "800": "#e75a7c",
        "900": "#e75a7c"
      },
      "orange": {
        "100": "#ff9966",
        "200": "#ff9966",
        "300": "#ff9966",
        "400": "#ff9966",
        "500": "#ff9966",
        "600": "#ff9966",
        "700": "#ff9966",
        "800": "#ff9966",
        "900": "#ff9966"
      },
      "yellow": {
